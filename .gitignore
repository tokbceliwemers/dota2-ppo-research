# Local Python environments and generated bytecode
.venv/
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
.pytest_cache/

# Local replay corpus, caches, model checkpoints, rollouts, and evaluation output
/replay/data/
/replay_training/data/
/replay_training/checkpoints/
/replay_training/reports/
/replay_training/deploy/

# Downloaded third-party research references are documented, not vendored.
/librarys/*
!/librarys/LIBRARIES.md

# Editor and operating-system files
.vscode/
.idea/
*.log
Thumbs.db
.DS_Store

# Local Codex workflow instructions are not project documentation.
/AGENTS.md
**/AGENTS.md
