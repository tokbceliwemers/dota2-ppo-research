# Local Python environments and generated bytecode
.venv/
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
.pytest_cache/

# Local replay corpus, caches, model checkpoints, rollouts, and evaluation output
/replay/data/
/replay_training/data/
/replay_training/checkpoints/
/replay_training/reports/
/replay_training/deploy/

# Current Shadow Fiend 1v1 stage outputs (the historical paths above are kept
# while Git detects the directory rename).
/sf1v1_training/data/
/sf1v1_training/checkpoints/
/sf1v1_training/reports/
/sf1v1_training/deploy/
/sf1v1_training/logs/
/sf1v1_simulator/data/
/sf1v1_evaluation/data/
/sf1v1_evaluation/reports/
/sf1v1_evaluation/logs/

# Downloaded third-party research references are documented, not vendored.
/librarys/*
!/librarys/LIBRARIES.md

# Editor and operating-system files
.vscode/
.idea/
*.log
Thumbs.db
.DS_Store

# Local Codex workflow instructions are not project documentation.
/AGENTS.md
**/AGENTS.md
